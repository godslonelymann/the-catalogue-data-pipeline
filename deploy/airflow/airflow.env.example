# Copy to /home/ubuntu/airflow/catalogue.env; chmod 600. No application secrets here.
# Compatible with both systemd EnvironmentFile and: set -a; source ...; set +a
AIRFLOW_HOME=/home/ubuntu/airflow
AIRFLOW__CORE__DAGS_FOLDER=/home/ubuntu/the-catalogue-data-pipeline/dags
CATALOGUE_PIPELINE_DIR=/home/ubuntu/the-catalogue-data-pipeline
CATALOGUE_BACKEND_DIR=/home/ubuntu/the-catalogue-backend

AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://catalogue_airflow:CHANGE_ME@127.0.0.1:5432/catalogue_airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
# The EC2 instance has 4 GB RAM and also runs Postgres and the API.
AIRFLOW__CORE__PARALLELISM=1
AIRFLOW__CORE__MAX_ACTIVE_TASKS_PER_DAG=1
AIRFLOW__DAG_PROCESSOR__PARSING_PROCESSES=1
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=True

# FAB provides a password login stored in Airflow's separate metadata database.
AIRFLOW__CORE__AUTH_MANAGER=airflow.providers.fab.auth_manager.fab_auth_manager.FabAuthManager
AIRFLOW__CORE__FERNET_KEY=CHANGE_ME
AIRFLOW__API_AUTH__JWT_SECRET=CHANGE_ME
AIRFLOW__API__SECRET_KEY=CHANGE_ME
AIRFLOW__API__HOST=127.0.0.1
AIRFLOW__API__PORT=8080
AIRFLOW__API__WORKERS=1
AIRFLOW__API__BASE_URL=http://localhost:8080
AIRFLOW__CORE__EXECUTION_API_SERVER_URL=http://127.0.0.1:8080/execution/
