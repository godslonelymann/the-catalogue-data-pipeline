# Copy to /etc/catalogue/airflow.env, owned by the service user, mode 600.
# Paths below assume the repos are deployed under /srv/catalogue/.
AIRFLOW_HOME=/srv/catalogue/airflow
AIRFLOW__CORE__DAGS_FOLDER=/srv/catalogue/the-catalogue-pipeline/airflow/dags
PYTHONPATH=/srv/catalogue/the-catalogue-pipeline:/srv/catalogue/the-catalogue-backend
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:CHANGE_ME@127.0.0.1:5432/airflow_metadata
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__PARALLELISM=2
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=True
AIRFLOW__CORE__DEFAULT_TIMEZONE=Asia/Kolkata
AIRFLOW__CORE__EXECUTION_API_SERVER_URL=http://127.0.0.1:8080/execution/
AIRFLOW__API__HOST=127.0.0.1
AIRFLOW__API__WORKERS=1
AIRFLOW__DAG_PROCESSOR__PARSING_PROCESSES=1
AIRFLOW__API_AUTH__JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
AIRFLOW__CORE__FERNET_KEY=REPLACE_WITH_FERNET_KEY
AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_USERS=admin:admin
AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_PASSWORDS_FILE=/srv/catalogue/airflow/passwords.json
DATABASE_URL=postgresql://pipeline:CHANGE_ME@127.0.0.1:5432/brands
ALERT_DATABASE_URL=postgresql://app_user:CHANGE_ME@127.0.0.1:5432/brands
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_CHAT_ID=CHANGE_ME
LOG_LEVEL=INFO
